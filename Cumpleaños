<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Para mi Winnie ❤️</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    font-family: Georgia, "Times New Roman", serif;
    background: #09030b;
    color: white;
    overflow-x: hidden;
}

body {
    background:
        radial-gradient(circle at 50% 15%, #641744 0%, #260b27 35%, #09030b 75%);
}

/* PÉTALOS */
#petals {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 20;
}

.petal {
    position: absolute;
    top: -40px;
    font-size: 22px;
    animation: caer linear forwards;
    opacity: .9;
}

@keyframes caer {
    0% {
        transform: translateY(-40px) rotate(0deg);
        opacity: 0;
    }

    10% {
        opacity: 1;
    }

    100% {
        transform:
            translate3d(var(--movimiento), 110vh, 0)
            rotate(600deg);
        opacity: 0;
    }
}

/* PANTALLAS */
.screen {
    min-height: 100vh;
    display: none;
    place-items: center;
    padding: 25px;
    position: relative;
    z-index: 2;
}

.screen.active {
    display: grid;
}

/* TARJETA */
.card {
    width: min(760px, 94vw);
    padding: 35px 25px;
    text-align: center;

    border-radius: 30px;

    background: rgba(25, 5, 25, .65);

    border: 1px solid rgba(255,255,255,.18);

    box-shadow:
        0 20px 70px rgba(0,0,0,.55),
        inset 0 0 40px rgba(255,100,180,.04);

    backdrop-filter: blur(10px);

    animation: aparecer 1.2s ease;
}

@keyframes aparecer {
    from {
        opacity: 0;
        transform: translateY(25px) scale(.97);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* TEXTOS */
h1 {
    font-size: clamp(38px, 9vw, 75px);
    margin: 15px 0;

    color: #ffd8ec;

    text-shadow:
        0 0 10px #ff79b9,
        0 0 30px #ff3c9c;
}

h2 {
    font-size: clamp(28px, 7vw, 50px);

    color: #ffd7e9;

    text-shadow:
        0 0 15px rgba(255,80,170,.8);
}

p {
    font-size: clamp(18px, 4.5vw, 23px);
    line-height: 1.7;
    color: #fff1f8;
}

.pequeno {
    font-size: 15px;
    opacity: .7;
}

/* FLORES */
.flores {
    font-size: 48px;
    letter-spacing: 8px;

    animation: florecer 2s ease-in-out infinite alternate;
}

